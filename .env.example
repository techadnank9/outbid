# Copy to .env (gitignored) for local use, or paste these into Render's
# dashboard for production. Never commit real secrets.

# ── Core ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000                       # Render sets this for you
DB_PATH=/var/data/outbit.db      # must be on the mounted persistent disk

# ── Branding ────────────────────────────────────────────────────
BRAND_NAME=Outbit                # appears on the Stripe receipt line item
# CRAWLER_UA=...                 # optional custom scraper user-agent

# ── URLs ────────────────────────────────────────────────────────
# PUBLIC_ORIGIN is the SITE the user sees, not this API. It builds the
# Stripe success/cancel redirects, so a customer who pays must land back
# on the site they started from. Getting this wrong only shows up after
# someone has already been charged.
PUBLIC_ORIGIN=https://outbidloll.web.app

# Frontend origins allowed to call this API. Firebase serves the site on
# BOTH hostnames, so list both or one of them breaks.
ALLOWED_ORIGINS=https://outbidloll.web.app,https://outbidloll.firebaseapp.com

# ── Stripe ──────────────────────────────────────────────────────
# Required in production; the server refuses to start without the key.
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Admin ───────────────────────────────────────────────────────
# Guards /api/admin/transactions, which exposes customer emails.
# Generate with: openssl rand -hex 32
# Unset means the endpoint is closed, not open.
ADMIN_TOKEN=

# ── Analytics (optional) ────────────────────────────────────────
DATAFAST_WEBSITE_ID=dfid_xxx
DATAFAST_DOMAIN=outbidloll.web.app
DATAFAST_SHARE_URL=https://datafa.st/share/xxx

# ── Frontend build (not a server variable) ──────────────────────
# Used by `npm run build` to bake the API origin into the static bundle.
API_BASE=https://<your-render-service>.onrender.com
